/* Bluetooth menu — styled to match the app launcher (config.rasi). Colors come from theme.rasi. */

@theme "~/.config/rofi/theme.rasi"

configuration {
  font:                   "Comic Mono 11";
  matching:               "fuzzy";
  case-smart:             true;
  click-to-exit:          true;
  hover-select:           true;
  me-select-entry:        "MousePrimary";
  me-accept-entry:        "!MousePrimary";
  kb-row-down:            "Down,Control+j,Control+n";
  kb-row-up:              "Up,Control+k,Control+p";
  kb-remove-to-eol:       "";
  kb-accept-entry:        "Return,KP_Enter";
  kb-cancel:              "Escape,Control+g,Control+bracketleft";
}

* {
  background-color:       transparent;
  text-color:             @main-fg;
  spacing:                0;
}

window {
  location:               north;
  anchor:                 north;
  y-offset:               41px;
  width:                  560px;
  border:                 1px;
  border-radius:          0;
  border-color:           @gray;
  background-color:       @main-bg;
  padding:                8px;
}

mainbox {
  spacing:                8px;
  children:               [ inputbar, listview ];
}

/* Search */

inputbar {
  padding:                8px 12px;
  spacing:                10px;
  background-color:       @input-bg;
  children:               [ prompt, entry, num-filtered-rows ];
}
prompt {
  text-color:             @main-br;
  vertical-align:         0.5;
}
entry {
  /* leading hair space keeps the cursor off the first letter */
  placeholder:            " Search devices";
  placeholder-color:      @dim-fg;
  cursor:                 text;
  vertical-align:         0.5;
}
num-filtered-rows {
  vertical-align:         0.5;
  text-color:             @dim-fg;
  expand:                 false;
}

/* Results */

listview {
  lines:                  8;
  columns:                1;
  fixed-height:           false;
  dynamic:                true;
  scrollbar:              false;
  cycle:                  false;
  spacing:                2px;
}

element {
  padding:                6px 10px;
  cursor:                 pointer;
}
element selected,
element selected.normal,
element selected.active {
  background-color:       @select-bg;
  text-color:             @select-fg;
}
element-text {
  vertical-align:         0.5;
  text-color:             inherit;
  cursor:                 inherit;
}
