set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $menu rofi -show drun

output * bg  ./bg.png fill
output eDP-1 resolution 3072x1920@120Hz

input type:touchpad {
        tap enabled
        natural_scroll enabled
}

input type:pointer {
        accel_profile "flat"
        natural_scroll enabled
}

input type:keyboard {
    xkb_options "caps:swapescape"
    repeat_delay 200
}

# Start a terminal
bindsym $mod+Return exec $term

# Kill focused window
bindsym $mod+w kill

# Start your launcher
bindsym $mod+m exec $menu

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

# Reload the configuration file
bindsym $mod+Ctrl+r reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Ctrl+q exec swaymsg exit

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+minus workspace number 11

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout stuff:
#
# You can "split" the current object of your focus with
# $mod+b or $mod+v, for horizontal and vertical splits
# respectively.
bindsym $mod+b splith
bindsym $mod+v splitv

# Switch the current container between different layout styles
# bindsym $mod+s layout stacking
bindsym $mod+t layout toggle tabbed split
bindsym $mod+e layout toggle split

# Make the current focus fullscreen
bindsym $mod+f exec ~/.config/sway/scripts/zen-mode
bindsym $mod+z fullscreen toggle
exec_always ~/.config/sway/scripts/zen-mode-listener
# bindsym $mod+f exec sway-zen


# Toggle the current focus between tiling and floating mode
# bindsym $mod+Shift+space floating toggle

# Swap focus between the tiling area and the floating area
# bindsym $mod+space focus mode_toggle
# Custom keymapping
bindsym $mod+tab workspace back_and_forth
bindsym $mod+q exec ~/.config/waybar/scripts/power-menu.sh
bindsym --locked XF86Explorer exec thunar
bindsym $mod+s exec toggle-spotify
bindsym $mod+space exec "dunstctl close"
# bindsym $mod+Shift+space exec "dunstctl close-all"
bindsym $mod+Shift+grave exec "dunstctl history-pop"
bindsym $mod+period exec pkill -SIGUSR1 -x waybar


# color picker
bindsym $mod+Shift+c exec wl-color-picker clipboard

#
# Resizing containers:
#
mode "resize" {
# left will shrink the containers width
# right will grow the containers width
# up will shrink the containers height
# down will grow the containers height
    bindsym $left resize shrink width 10px
        bindsym $down resize grow height 10px
        bindsym $up resize shrink height 10px
        bindsym $right resize grow width 10px

# Ditto, with arrow keys
        bindsym Left resize shrink width 10px
        bindsym Down resize grow height 10px
        bindsym Up resize shrink height 10px
        bindsym Right resize grow width 10px

# Return to default mode
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Control brightness
bindsym Control+Shift+j exec changebrightness down

bindsym Control+Shift+k exec changebrightness up

bindsym --locked XF86MonBrightnessDown exec changebrightness down

bindsym --locked XF86MonBrightnessUp exec changebrightness up

#
# Utilities:
#
# Special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec volumeup

# Switch audio output (speakers / Bluetooth / HDMI)
bindsym $mod+F12 exec audio-switch
bindsym $mod+Shift+F12 exec audio-switch menu
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# Special key to take a screenshot with grim
bindsym $mod+p exec sway-screenshot -o $HOME/Pictures/screenshots -m window
bindsym $mod+Shift+p exec sway-screenshot -o $HOME/Pictures/screenshots -m region --active

# Lock the screen on demand instead of waiting for swayidle's timeout
bindsym $mod+Ctrl+l exec swaylock -f
bar {
    position top
    swaybar_command waybar
}

######################### UI #########################

# remove title bar and border from the window
default_border pixel 1 
default_floating_border none
titlebar_padding 5 1
titlebar_border_thickness 1

gaps inner 10
# waybar is non-exclusive (overlay); reserve its height as a top gap instead
gaps top 31
# waybar sits on the bottom layer (behind windows); zen mode sets this to 0 so the window covers it

# title-border background text indicator child border(the window itself)
# Gruvbox Material Dark
client.focused                #45403d #45403d #d8a657 #d8a657 #d8a657
client.focused_inactive       #32302f #32302f #ddc7a1 #d8a657 #282828
client.unfocused                #282828 #1d2021 #928374 #d8a657 #282828
client.urgent                #282828 #1d2021 #928374 #ea6962 #282828

## change cursor
seat seat0 xcursor_theme Simp1e-Gruvbox-Dark 19

xwayland enable

font pango:Comic Mono 11

include /etc/sway/config.d/*

for_window [app_id="^(?i)spotify$"] move container to workspace 11
for_window [class="^Spotify$"] move container to workspace 11

bindsym $mod+Shift+Space floating toggle

exec_always swww-daemon &

# Clipboard history (cliphist): record text and images
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
# Super+Shift+V: pick from history in rofi (with image thumbnails)
bindsym $mod+Shift+v exec rofi -modi clipboard:~/.local/bin/cliphist-rofi-img -show clipboard -show-icons

# Window picker ($mod+/): fuzzy-find windows on the current workspace
bindsym $mod+slash exec ~/.config/sway/scripts/window-picker
for_window [app_id="^window-picker$"] floating enable, resize set 900 450, move position center, border none

# Night light (wlsunset): warm 4000K from 20:00 to 07:00; $mod+Shift+n toggles it
exec wlsunset -S 07:00 -s 20:00 -t 4000 -T 6500
bindsym $mod+Shift+n exec ~/.config/sway/scripts/nightlight-toggle

# Super+Shift+T: start a sowon countdown timer (toggles a running timer, else prompts via rofi)
bindsym $mod+Shift+t exec ~/.config/sway/scripts/sowon-timer
for_window [title="- sowon \(RGFW\)$"] floating enable, resize set 640 260, move position center, move scratchpad, scratchpad show

# Floating qalc calculator (toggle with $mod+c)
for_window [app_id="floatcalc"] floating enable, resize set 50 ppt 60 ppt, move position center, move scratchpad, scratchpad show
bindsym $mod+c exec swaymsg '[app_id="floatcalc"] scratchpad show' || kitty --class floatcalc --title Calculator -o font_size=15 -o window_padding_width=10 -o background_opacity=0.95 -o cursor_shape=block qalc
