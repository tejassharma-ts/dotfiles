#!/usr/bin/env bash

source ~/.config/fzf/theme.sh

selected=$(find ~/walls -mindepth 2 -maxdepth 2 -type f \( -name "*.png" -o -name "*.jpg" \) | fzf )

[[ -z $selected ]] && exit 0

swww img -t fade --transition-step 10 $selected

