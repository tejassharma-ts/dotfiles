#!/bin/bash

source ~/.config/fzf/theme.sh

session=$(tmux ls | awk -F: '
    /attached/ {print $1 "\033[32m *\033[0m"}
    !/attached/ {print $1} 
' | fzf-tmux -p --ansi)
session=$(echo "$session" | sed 's/ (attached)$//')
if [ -n "$session" ]; then
    tmux switch-client -t "$session"
else
    echo "No session selected."
fi

